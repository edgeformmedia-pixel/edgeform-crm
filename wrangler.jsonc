{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "edgeform-crm-api",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-12",
  "observability": { "enabled": true },
  "vars": {
    "AUTH_SERVICE_URL": "https://script.google.com/macros/s/AKfycby7Mx_dPxxYqjc9LUuAvUP1_X0nVO2ip24XnC9A9bC80FaSZMDq5QB10AK22rK4GcEh/exec",
    "ALLOWED_ORIGINS": "https://edgeform-media.com,https://www.edgeform-media.com,https://crm.edgeform-media.com,http://localhost:8787,http://localhost:8000,http://localhost:5173,http://localhost:4174,http://127.0.0.1:5173,http://127.0.0.1:4174"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "edgeform-crm",
      "database_id": "1af18fc6-2c2a-4789-9ceb-5710072a39ea",
      "migrations_dir": "migrations"
    }
  ]
}
