{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "edgeform-crm-api",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-12",
  "observability": { "enabled": true },
  // Secrets (set with `wrangler secret put`): RESEND_API_KEY
  "vars": {
    "MAIL_FROM": "Edgeform CRM <noreply@edgeformmarketing.com>",
    "MAIL_DOMAIN": "edgeformmarketing.com",
    // Used only until RESEND_API_KEY is set.
    "EMAIL_WORKER_URL": "https://email.edgeformmedia.workers.dev",
    // Base URL used in invite links.
    "APP_URL": "https://crm.edgeformmarketing.com",
    "ALLOWED_ORIGINS": "https://crm.edgeformmarketing.com,https://edgeformmarketing.com,https://www.edgeformmarketing.com,https://edgeform-media.com,https://www.edgeform-media.com,https://crm.edgeform-media.com,http://localhost:8787,http://localhost:8000,http://localhost:5173,http://localhost:4174,http://127.0.0.1:5173,http://127.0.0.1:4174"
  },
  // Website sketch images uploaded by the intake form.
  "r2_buckets": [
    { "binding": "SKETCHES", "bucket_name": "edgeform-crm-sketches" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "edgeform-crm",
      "database_id": "1af18fc6-2c2a-4789-9ceb-5710072a39ea",
      "migrations_dir": "migrations"
    }
  ]
}
