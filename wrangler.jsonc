{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "edgeform-crm-api",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-12",
  "observability": { "enabled": true },
  // Secrets (set with `wrangler secret put`): RESEND_API_KEY
  "vars": {
    "MAIL_FROM": "Edgeform CRM <noreply@edgeformmarketing.com>",
    "MAIL_DOMAIN": "edgeformmarketing.com",
    // Used only until RESEND_API_KEY is set.
    "EMAIL_WORKER_URL": "https://email.edgeformmedia.workers.dev",
    // Comma-separated emails or @domains allowed to sign up. Empty = anyone who verifies their email.
    "SIGNUP_ALLOWLIST": "",
    "TIMEZONE": "America/Detroit",
    // http://crm... is temporary until GitHub Pages issues the HTTPS certificate for the new domain.
    "ALLOWED_ORIGINS": "https://crm.edgeformmarketing.com,http://crm.edgeformmarketing.com,https://edgeformmarketing.com,https://www.edgeformmarketing.com,https://edgeform-media.com,https://www.edgeform-media.com,https://crm.edgeform-media.com,http://localhost:8787,http://localhost:8000,http://localhost:5173,http://localhost:4174,http://127.0.0.1:5173,http://127.0.0.1:4174"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "edgeform-crm",
      "database_id": "1af18fc6-2c2a-4789-9ceb-5710072a39ea",
      "migrations_dir": "migrations"
    }
  ]
}
