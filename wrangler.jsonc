{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "edgeform-crm-api",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-12",
  "observability": { "enabled": true },
  // Secrets: AI_SETTINGS_ENCRYPTION_KEY; optionally OPENAI_API_KEY, RESEND_API_KEY, RESEND_WEBHOOK_SECRET.
  // Affiliate secrets: AFFILIATE_ENCRYPTION_KEY (payout details). Views are checked by hand; no view-provider secrets.
  "vars": {
    // Non-secret AI configuration. Override without changing browser code.
    "OPENAI_MODEL": "gpt-5.6-terra",
    "OPENAI_DISCOVERY_MODEL": "gpt-5.6-terra",
    "OPENAI_DISCOVERY_INPUT_USD_PER_MTOK": "2",
    "OPENAI_DISCOVERY_OUTPUT_USD_PER_MTOK": "12",
    "OPENAI_WEB_SEARCH_USD_PER_CALL": "0.01",
    "OPENAI_SEARCH_INPUT_TOKENS_ESTIMATE": "12000",
    "MAIL_FROM": "Edgeform CRM <noreply@edgeformmarketing.com>",
    "MAIL_DOMAIN": "edgeformmarketing.com",
    // Used only until RESEND_API_KEY is set.
    "EMAIL_WORKER_URL": "https://email.edgeformmedia.workers.dev",
    // Base URL used in invite links.
    "APP_URL": "https://crm.edgeformmarketing.com",
    // Public URL of this Worker, used for inline images in received mail.
    "API_URL": "https://edgeform-crm-api.edgeformmedia.workers.dev",
    // Shared inboxes: the only account with access to admin@.
    "MAIL_OWNER_EMAIL": "edgeformmedia@gmail.com",
    // Email signature.
    "MAIL_COMPANY": "Edgeform Marketing Group",
    "MAIL_ADDRESS": "55 NE 2nd St, Miami, FL 33132",
    "MAIL_PHONE": "5862246692",
    "MAIL_WEBSITE": "https://edgeformmarketing.com",
    "MAIL_LOGO_URL": "https://crm.edgeformmarketing.com/assets/efmg-logo.png",
    "MAIL_INSTAGRAM_URL": "https://www.instagram.com/edgeformmarketing/",
    "ALLOWED_ORIGINS": "https://crm.edgeformmarketing.com,https://affiliate.edgeformmarketing.com,http://localhost:5500,https://edgeformmarketing.com,https://www.edgeformmarketing.com,https://edgeform-media.com,https://www.edgeform-media.com,https://crm.edgeform-media.com,http://localhost:8787,http://localhost:8000,http://localhost:5173,http://localhost:4174,http://127.0.0.1:5173,http://127.0.0.1:4174"
  },
  "triggers": { "crons": ["* * * * *"] },
  "r2_buckets": [
    // Website sketch images uploaded by the intake form.
    { "binding": "SKETCHES", "bucket_name": "edgeform-crm-sketches" },
    // Email attachments, inline images, and oversized message bodies.
    { "binding": "MAIL_FILES", "bucket_name": "edgeform-crm-mail" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "edgeform-crm",
      "database_id": "1af18fc6-2c2a-4789-9ceb-5710072a39ea",
      "migrations_dir": "migrations"
    }
  ]
}
